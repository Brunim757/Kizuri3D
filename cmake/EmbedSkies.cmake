file(GLOB SKY_FILES "${IN_DIR}/*.hdr")
file(WRITE "${OUT}" "// auto-generated: embedded HDR skies - do not edit\n")
file(APPEND "${OUT}" "#include \"Kizuri/Assets/EmbeddedSkies.h\"\n#include <cstddef>\nnamespace Kizuri {\n")
set(idx 0)
set(entries "")
foreach(f IN LISTS SKY_FILES)
  get_filename_component(nm "${f}" NAME)
  file(READ "${f}" HEX hx)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hx}")
  file(APPEND "${OUT}" "static const unsigned char kSky${idx}[] = {${bytes}};\n")
  set(entries "${entries}  {\"${nm}\", kSky${idx}, sizeof(kSky${idx})},\n")
  math(EXPR idx "${idx} + 1")
endforeach()
file(APPEND "${OUT}" "static const EmbeddedSkyEntry kSkies[] = {\n${entries}};\n")
file(APPEND "${OUT}" "size_t EmbeddedSkyCount() { return sizeof(kSkies) / sizeof(kSkies[0]); }\n")
file(APPEND "${OUT}" "const EmbeddedSkyEntry& EmbeddedSkyAt(size_t i) { return kSkies[i < EmbeddedSkyCount() ? i : 0]; }\n")
file(APPEND "${OUT}" "} // namespace Kizuri\n")
